body
{
	z-index:-1;
}

/*Button labels hang below their button without taking part in layout. Their text height is fixed
  in pixels while everything else scales with the window, so an in-flow label would push the icons
  around differently at every resolution.

  Vertical offsets on this screen use padding, never margin: libRocket resolves vertical margin
  percentages against the containing block's height (which here depends on text size), but padding
  percentages against its width, so padding scales with the art. Here they're % of the button width.*/
.below p
{
	display: block;
	position: absolute;
	width: 300%;
	margin-left: -100%;
}

#player_control .below p
{
	padding-top: 42%;
}

#player_select .below p
{
	padding-top: 26%;
}

div#logo_wide
{
	position: absolute;
	bottom: 4%;
	margin: auto;
	width: 70%;
	height: auto;
	overflow: hidden;
}

div#logo_wide img
{
	display: block;
	width: 100%;
	height: auto;
}

div#copyright_info
{
	position: absolute;
	bottom: 1%;
	margin: auto;
	width: 70%;
	height: auto;
	overflow: hidden;
	text-align: center;
}

div#pilotlist
{
	position: absolute;
	top: 0;
	margin-top: 23%;
	margin-left: 2%;
	margin-right: 5%;
	color: white;
	overflow: auto;
	height: 52%;
}

.pilotlist_element
{
	display: block;
	color: #7b7b7b;
}
.pilotlist_element:hover
{
	color: #abbbab;
}
.pilotlist_element:checked
{
	color: #6f92f5;
}

.player_type_text
{
	color: white;
	display: none;
	text-align: center;
	margin: 5%;
}

div#singleplayer_text:checked
{
	display: block;
}

div#multiplayer_text:checked
{
	display: block;
}

div#pilot_select
{
	margin: auto;
	margin-top: 15%;
	width: 50%;
	height: auto;
	overflow: hidden;
	position: relative;
}

div#pilot_select img
{
	display: block;
	width: 100%;
	height: auto;
}

.window_title
{
	margin-top: 4%;
	margin-left: 4%;
}

/*Each bottom button row is anchored to the bottom of the window art (1911x737) and given exactly
  the footprint of its panel, so the % values inside resolve against a known width rather than a
  shrink-to-fit one, and the rows don't overlap each other's buttons. Each button's padding-bottom
  lifts it into place.*/

/*Right panel: art x 1435-1911*/
div#player_select
{
	position: absolute;
	bottom: 0;
	left: 75.1%;
	width: 24.9%;
}

div#player_type_select
{
	position: absolute;
	top: 0;
}

/*Left panel: art x 0-810*/
div#player_control
{
	position: absolute;
	bottom: 0;
	left: 0;
	width: 42.4%;
}

div#player_control_wrapper
{
	width: 100%;
	margin-left: -2.2%;
}

/*Arrow Buttons*/

div#arrow_cont
{
	float: right;
	width: 15.3%;
	height: auto;
	margin-right: 9.2%;
	/*Floats line up along the top of the row, which the taller Select button sets, so the arrows are
	  placed from the top*/
	padding-top: 6.5%;
}

.arrowbuttons
{
	display: block;
	width: 100%;
	height: auto;

}

#playerprev_img
{
	background-decorator: image;
	background-image: arrow-up.png;
}

#playernext_img
{
	background-decorator: image;
	background-image: arrow-down.png;
}

button#playerprev_btn:hover #playerprev_img
{
	background-decorator: image;
	background-image: arrow-up-h.png;
}

button#playernext_btn:hover #playernext_img
{
	background-decorator: image;
	background-image: arrow-down-h.png;
}

button#playerprev_btn:active #playerprev_img
{
	background-decorator: image;
	background-image: arrow-up-o.png;
}

button#playernext_btn:active #playernext_img
{
	background-decorator: image;
	background-image: arrow-down-o.png;
}

/*Commit Button*/

div#player_commit_cont
{
	float: right;
	position: relative; /*containing block for its label*/
	width: 30.5%;
	height: auto;
	margin-right: 7.4%;
	padding-bottom: 6.2%;
}

.playercommit
{
	display: block;
	width: 100%;
	height: auto;

}

#playercommit_img
{
	background-decorator: image;
	background-image: select.png;
}

button#playercommit_btn:hover #playercommit_img
{
	background-decorator: image;
	background-image: select-neg-h.png;
}

button#playercommit_btn:active #playercommit_img
{
	background-decorator: image;
	background-image: select-neg-o.png;
}

/*Singleplayer Selection Button*/

div#single_multi_cont
{
	float: right;
	width: 6%;
	height: auto;
	margin-right: 4%;
	margin-bottom: 1%;
	margin-top: 1%;
}

.singleplayer
{
	display: block;
	width: 100%;
	height: auto;

}

#singleplayer_img
{
	background-decorator: image;
	background-image: single-player.png;
}

#singleplayer_btn:hover #singleplayer_img
{
	background-decorator: image;
	background-image: single-player-h.png;
}

#singleplayer_btn:active #singleplayer_img
{
	background-decorator: image;
	background-image: single-player-o.png;
}

#singleplayer_btn:checked #singleplayer_img
{
	background-decorator: image;
	background-image: single-player-o.png;
}

/*Multiplayer Selection Button*/

.multiplayer
{
	display: block;
	width: 100%;
	height: auto;

}

#multiplayer_img
{
	background-decorator: image;
	background-image: multiplayer.png;
}

button#multiplayer_btn:hover #multiplayer_img
{
	background-decorator: image;
	background-image: multiplayer-h.png;
}

button#multiplayer_btn:active #multiplayer_img
{
	background-decorator: image;
	background-image: multiplayer-o.png;
}

button#multiplayer_btn:checked #multiplayer_img
{
	background-decorator: image;
	background-image: multiplayer-o.png;
}

/*Create Player Button*/

div#player_control_cont
{
	float: left;
	position: relative; /*containing block for its label*/
	width: 14%;
	height: auto;
	margin-left: 14.1%;
	padding-bottom: 4.8%;
	z-index: 1;
}

.createplayer
{
	display: block;
	width: 100%;
	height: auto;

}

#createplayer_img
{
	background-decorator: image;
	background-image: create-pilot.png;
}

button#createplayer_btn:hover #createplayer_img
{
	background-decorator: image;
	background-image: create-pilot-h.png;
}

button#createplayer_btn:active #createplayer_img
{
	background-decorator: image;
	background-image: create-pilot-o.png;
}

/*Clone Player Button*/

.cloneplayer
{
	display: block;
	width: 100%;
	height: auto;

}

#cloneplayer_img
{
	background-decorator: image;
	background-image: clone-pilot.png;
}

button#cloneplayer_btn:hover #cloneplayer_img
{
	background-decorator: image;
	background-image: clone-pilot-h.png;
}

button#cloneplayer_btn:active #cloneplayer_img
{
	background-decorator: image;
	background-image: clone-pilot-o.png;
}

/*Delete Player Button*/

.deleteplayer
{
	display: block;
	width: 100%;
	height: auto;

}

#deleteplayer_img
{
	background-decorator: image;
	background-image: delete-pilot.png;
}

button#deleteplayer_btn:hover #deleteplayer_img
{
	background-decorator: image;
	background-image: delete-pilot-h.png;
}

button#deleteplayer_btn:active #deleteplayer_img
{
	background-decorator: image;
	background-image: delete-pilot-o.png;
}

/*Pilot List Scroll Bar*/

#pilotlist scrollbarvertical
{
	margin-top: -1%;
	margin-bottom: -1%;
	margin-right: -2.5%;
	width: 5%;
	scrollchange-sound: 9;
	z-index: 5;
}

#pilotlist scrollbarvertical slidertrack
{
	background-decorator: image;
	background-image: scroll-bar-line.png;
	width: 8%;
	margin-left: 46%;
}

#pilotlist scrollbarvertical sliderbar
{
	width: 65%;
	height: 15%;
	background-decorator: image;
	background-image: scroll-button.png;
	margin-left: 20%;
}

#pilotlist scrollbarvertical sliderbar:hover
{
	background-image: scroll-button-h.png;
}

#pilotlist scrollbarvertical sliderbar:active
{
	background-image: scroll-button-o.png;
}

#pilotlist scrollbarvertical sliderarrowdec
{
	width: 100%;
	height: 27%;
	padding-bottom: 10%;
	mouseover-sound: 17;
	click-sound: 0;
	icon-decorator: image;
	icon-image: arrow-dbl-up.png;
}

#pilotlist scrollbarvertical sliderarrowinc
{
	width: 100%;
	height: 27%;
	mouseover-sound: 17;
	click-sound: 0;
	icon-decorator: image;
	icon-image: arrow-dbl-down.png;
}

#pilotlist scrollbarvertical sliderarrowdec:hover
{
	icon-image: arrow-dbl-up-h.png;
}

#pilotlist scrollbarvertical sliderarrowinc:hover
{
	icon-image: arrow-dbl-down-h.png;
}

#pilotlist scrollbarvertical sliderarrowdec:active
{
	icon-image: arrow-dbl-up-o.png;
}

#pilotlist scrollbarvertical sliderarrowinc:active
{
	icon-image: arrow-dbl-down-o.png;
}
