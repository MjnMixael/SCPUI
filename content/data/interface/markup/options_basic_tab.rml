<body>
<div class="options_column_40">
    <div id="skill_level_container">
        <!-- Filled in by Lua -->
    </div>
    <div class="btn_panel_large">
        <div id="large_panel_text" class="ops_left_header">
            <p>XSTR("Volume", 888162)</p>
        </div>
        <div id="volume_sliders_container" class=large_panel_wrapper>
            <!-- Filled in by Lua -->
        </div>
        <img src="ops-panel-large-l.png"></img>
    </div>
    <div class="btn_panel_large mouse_settings">
        <div id="mouse_options_container" class=large_panel_wrapper>
            <!-- Filled in by Lua -->
        </div>
    </div>
	<div id="quick_options_wrapper">
		<div id="quick_options_col_1">
			<div id="font_size_selector">
				<!-- Lua will fill in the options UI elements here -->
			</div>
			<div id="language_selector">
				<!-- Lua will fill in the options UI elements here -->
			</div>
			<div id="brief_choice_selector">
				<!-- Lua will fill in the options UI elements here -->
			</div>
		</div>
		<div id="quick_options_col_2">
			<div id="directional_hit">
				<!-- Lua will fill in the options UI elements here -->
			</div>
			<div id="force_feeback_selector">
				<!-- Lua will fill in the options UI elements here -->
			</div>
			<div id="force_feedback_sensitivity">
				<!-- Lua will fill in the options UI elements here -->
			</div>
		</div>
	</div>
</div>
<div class="options_column_20">
</div>
<div id="basic_right_column" class="options_column_40 panel_right">
    <div id=gamma_option class="btn_panel_large panel_right">
        <div id="large_panel_text" class="ops_right_header">
            <p>XSTR("Brightness", 888163)</p>
        </div>
        <div id=gamma_panel_wrapper>
            <div id="gamma_controls" class="gamma_setting">
                <div id=arrow_cont>
                    <button id="brightness_increase_btn" class="right_arrow_btn arrow button_1">
                        <div id="right_arrow_img" class="arrow button_img">
                            <img src="arrow-right.png" class="psuedo_img"></img>
                        </div>
                    </button>
                </div>
                <div id=arrow_cont>
                    <button id="brightness_decrease_btn" class="left_arrow_btn arrow button_1">
                        <div id="left_arrow_img" class="arrow button_img">
                            <img src="arrow-left.png" class="psuedo_img"></img>
                        </div>
                    </button>
                </div>
                <div id="gamma_value" class="header_text">
                    <p id="brightness_value_el">1.00</p>
                </div>
            </div>
        </div>
        <div id=gamma_graphic_wrapper>
            <div id=gamma_graphic>
                <img src="gamma.png" height="60px" />
            </div>
        </div>
        <img src="ops-panel-gamma.png"></img>
    </div>
	<div id="hdr_settings_wrapper" class="btn_panel_large panel_right">
		<div id="large_panel_text" class="ops_right_header">
			<p>XSTR("HDR Calibration", 888578)</p>
		</div>
		<div id="hdr_toggle_text">
			<p id="hdr_toggle_title"></p> <!-- Filled from the option title by Lua -->
		</div>
		<div id="hdr_toggle_wrapper">
			<div id="hdr_on_entry" class="hdr_toggle_entry">
				<div class="hdr_toggle_btn">
					<button id="hdr_btn_2" class="round button_1">
						<div id="round_img" class="round button_img">
							<img src="round.png" class="psuedo_img"></img>
						</div>
					</button>
				</div>
				<p id="hdr_btn_2_text" class="hdr_toggle_label"></p> <!-- Filled from the option values by Lua -->
			</div>
			<div id="hdr_off_entry" class="hdr_toggle_entry">
				<div class="hdr_toggle_btn">
					<button id="hdr_btn_1" class="round button_1">
						<div id="round_img" class="round button_img">
							<img src="round.png" class="psuedo_img"></img>
						</div>
					</button>
				</div>
				<p id="hdr_btn_1_text" class="hdr_toggle_label"></p> <!-- Filled from the option values by Lua -->
			</div>
		</div>
		<div id="hdr_content_wrapper">
			<div id="hdr_paperwhite_row" class="hdr_widget_row">
				<div class="ops_left_header">
					<span id="hdr_paperwhite_title"></span>: <span id="hdr_paperwhite_value" class="header_text"></span>
				</div>
				<div class="hdr_range_wrapper">
					<div id=range_cont>
						<input id="hdr_paperwhite_range" type="range" min="0" max="1" step="0.01"></input>
						<img src="ops-panel-horz.png" class="psuedo_img"></img>
					</div>
				</div>
			</div>
			<div id="hdr_peak_row" class="hdr_widget_row">
				<div class="ops_left_header">
					<span id="hdr_peak_title"></span>: <span id="hdr_peak_value" class="header_text"></span>
				</div>
				<div class="hdr_range_wrapper">
					<div id=range_cont>
						<input id="hdr_peak_range" type="range" min="0" max="1" step="0.01"></input>
						<img src="ops-panel-horz.png" class="psuedo_img"></img>
					</div>
				</div>
			</div>
			<div id="hdr_ramp_row">
				<div id="hdr_patch_1" class="hdr_patch"></div>
				<div id="hdr_patch_2" class="hdr_patch"></div>
				<div id="hdr_patch_3" class="hdr_patch"></div>
				<div id="hdr_patch_4" class="hdr_patch"></div>
				<div id="hdr_patch_5" class="hdr_patch"></div>
				<div id="hdr_patch_6" class="hdr_patch"></div>
				<div id="hdr_patch_7" class="hdr_patch"></div>
				<div id="hdr_patch_8" class="hdr_patch"></div>
				<div id="hdr_patch_9" class="hdr_patch"></div>
			</div>
			<div id="hdr_primaries_row">
				<div class="hdr_patch hdr_patch_red"></div>
				<div class="hdr_patch hdr_patch_green"></div>
				<div class="hdr_patch hdr_patch_blue"></div>
				<div class="hdr_patch hdr_patch_white"></div>
			</div>
		</div>
		<img src="ops-panel-gen-r.png"></img>
	</div>
	<div id="joystick_selection_wrapper">
		<div id="joystick_category_text">
            <p>XSTR("Joystick Selections", 888164)</p>
        </div>
		<div id="joystick_column_1">
			<!-- Lua will fill in the options UI elements here -->
		</div>
		<div id="joystick_column_2">
			<!-- Lua will fill in the options UI elements here -->
		</div>
	</div>
	<div id="joystick_settings" class="joystick_settings1">
        <div id="joystick_category_text">
            <p>XSTR("Global Joystick Settings", 888165)</p>
        </div>
        <div id="joystick_values_wrapper" class=large_panel_wrapper>
            <!-- Lua will fill in the options UI elements here -->
        </div>
    </div>
</div>
</body>