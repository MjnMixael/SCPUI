<body>
<div id="graphics_options_wrapper">
<div id="graphics_scroll_panel">
	<img src="ops-panel-vert-tall-r.png"></img>
</div>
<div id="graphics_scroll_panel_btm">
	<img src="ops-panel-vert-tall-r.png"></img>
</div>
<div id="graphics_column_1" class="options_column_25"> <!--left column button panels, not scrolled-->
    <div class="btn_panel_vert_tall"> <!--This begins all the rml for the preset selector-->
        <div id="vert_tall_panel_text">
            <p id="preset_title">XSTR("Preset Graphics Level", 888169)</p>
        </div>
        <div id=vert_tall_panel_wrapper>
            <div id=bullet_choice_cont>
                <button id="det_min_btn" class="bullet button_1" onclick="controller:set_detail_minimum(element)">
                    <div id="bullet_r_img" class="bullet button_img">
                        <img src="bullet-r.png" class="psuedo_img"></img>
                    </div>
                    <div class="pos button_text_right">
                        <p>XSTR("Minimum", 888170)</p>
                    </div>
                </button>
            </div>
            <div id=bullet_choice_cont>
                <button id="det_low_btn" class="bullet button_1" onclick="controller:set_detail_low(element)">
                    <div id="bullet_r_img" class="bullet button_img">
                        <img src="bullet-r.png" class="psuedo_img"></img>
                    </div>
                    <div class="pos button_text_right">
                        <p>XSTR("Low", 888171)</p>
                    </div>
                </button>
            </div>
            <div id=bullet_choice_cont>
                <button id="det_med_btn" class="bullet button_1" onclick="controller:set_detail_medium(element)">
                    <div id="bullet_r_img" class="bullet button_img">
                        <img src="bullet-r.png" class="psuedo_img"></img>
                    </div>
                    <div class="pos button_text_right">
                        <p>XSTR("Medium", 888172)</p>
                    </div>
                </button>
            </div>
            <div id=bullet_choice_cont>
                <button id="det_hig_btn" class="bullet button_1" onclick="controller:set_detail_high(element)">
                    <div id="bullet_r_img" class="bullet button_img">
                        <img src="bullet-r.png" class="psuedo_img"></img>
                    </div>
                    <div class="pos button_text_right">
                        <p>XSTR("High", 888173)</p>
                    </div>
                </button>
            </div>
            <div id=bullet_choice_cont>
                <button id="det_ult_btn" class="bullet button_1" onclick="controller:set_detail_ultra(element)">
                    <div id="bullet_r_img" class="bullet button_img">
                        <img src="bullet-r.png" class="psuedo_img"></img>
                    </div>
                    <div class="pos button_text_right">
                        <p>XSTR("Ultra", 888174)</p>
                    </div>
                </button>
            </div>
            <div id=bullet_choice_cont>
                <button id="det_cst_btn" class="bullet button_1" onclick="controller:set_detail_custom(element)">
                    <div id="bullet_r_img" class="bullet button_img">
                        <img src="bullet-r.png" class="psuedo_img"></img>
                    </div>
                    <div class="pos button_text_right">
                        <p>XSTR("Custom", 888167)</p>
                    </div>
                </button>
            </div>
        </div>
        <img src="ops-panel-vert-tall-l.png"></img>
    </div>
</div>
<div id="graphics_options_scroll">
	<div id="graphics_column_2" class="options_column_25">
	</div> <!--middle column. Any buttons here need "horz_middle" added to their class-->
	<div id="graphics_column_3" class="options_column_25">
	</div> <!--middle column. Any buttons here need "horz_middle" added to their class-->
	<div id="graphics_column_4" class="options_column_25">
	</div> <!--middle column. Any buttons here need "horz_right" added to their class-->
</div>
<div id="graphics_options_sizer">
	<img src="options-window.png"></img>
</div>
</div>
</body>