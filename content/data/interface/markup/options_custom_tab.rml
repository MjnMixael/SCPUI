<body>
<div id="custom_options_wrapper">
<div id="custom_scroll_panel">
	<img src="ops-panel-vert-tall-r.png"></img>
</div>
<div id="custom_scroll_panel_btm">
	<img src="ops-panel-vert-tall-r.png"></img>
</div>
<div id="custom_column_1" class="options_column_25"> <!--left column button panels, not scrolled-->
    <div class="btn_panel_vert">
        <div id="vert_panel_text">
            <p id="preset_title">XSTR("Game Options", 888166)</p>
        </div>
        <div id=vert_panel_wrapper>
            <div id=bullet_choice_cont>
                <button id="mod_custom_btn" class="bullet button_1" onclick="controller:set_mod_detail_custom(element)">
                    <div id="bullet_r_img" class="bullet button_img">
                        <img src="bullet-r.png" class="psuedo_img"></img>
                    </div>
                    <div class="pos button_text_right">
                        <p>XSTR("Custom", 888167)</p>
                    </div>
                </button>
            </div>
            <div id=bullet_choice_cont>
                <button id="mod_default_btn" class="bullet button_1" onclick="controller:set_mod_detail_default(element)">
                    <div id="bullet_r_img" class="bullet button_img">
                        <img src="bullet-r.png" class="psuedo_img"></img>
                    </div>
                    <div class="pos button_text_right">
                        <p>XSTR("Mod Default", 888168)</p>
                    </div>
                </button>
            </div>
        </div>
        <img src="ops-panel-vert-l.png"></img>
    </div>
</div>
<div id="custom_options_scroll">
	<div id="custom_column_2" class="options_column_25">
	</div> <!--middle column. Any buttons here need "horz_middle" added to their class-->
	<div id="custom_column_3" class="options_column_25">
	</div> <!--middle column. Any buttons here need "horz_middle" added to their class-->
	<div id="custom_column_4" class="options_column_25">
	</div> <!--middle column. Any buttons here need "horz_right" added to their class-->
</div>
<div id="custom_options_sizer">
	<img src="options-window.png"></img>
</div>
</div>
</body>